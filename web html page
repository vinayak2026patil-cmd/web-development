        </tr>

        <tr>
            <td>S003</td>
            <td>P003</td>
            <td>40</td>
            <td>10</td>
            <td>20</td>
            <td>30</td>
            <td>10</td>
        </tr>
    </table>

    <p>
        <b>Available Stock = Opening Stock + Purchased − Sold</b>
    </p>

    <br>

    <!-- Sale Details -->
    <h2>3. Sale Details</h2>

    <table border="1" cellpadding="8">
        <tr>
            <th>Sale ID</th>
