    <!-- Stock Details -->
    <h2>2. Stock Details</h2>

    <table border="1" cellpadding="8">
        <tr>
            <th>Stock ID</th>
            <th>Product ID</th>
            <th>Opening Stock</th>
            <th>Purchased</th>
            <th>Sold</th>
