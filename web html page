    <!-- Bill Calculation -->
    <h2>5. Bill Calculation</h2>

    <table border="1" cellpadding="8">
        <tr>
            <th>Description</th>
            <th>Amount</th>
        </tr>

        <tr>
            <td>Product Price</td>
            <td>₹50,000</td>
        </tr>

        <tr>
            <td>Quantity</td>
